<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/color_333535" android:endColor="@color/color_63676b" android:angle="90.0" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_main" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="@color/color_1f000000" android:endColor="@color/color_1fffffff" android:angle="90.0" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>