<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <padding android:left="4.0px" android:top="4.0px" android:right="4.0px" android:bottom="4.0px" />
            <stroke android:width="3.0px" android:color="@color/color_main" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_hovered="true">
        <shape>
            <padding android:left="4.0px" android:top="4.0px" android:right="4.0px" android:bottom="4.0px" />
            <stroke android:width="3.0px" android:color="@color/color_main" />
        </shape>
    </item>
    <item android:drawable="@color/transparent" />
</selector>